{"line": 1155, "phrase": "КӀАЛ ЦӀОРОЯВӀ", "page": 173, "path": ["examples", 0, "ru"], "text": "— Болтайте, вдовушки! Есть тепёрь пища для ваших сплетен. Перемывайте косточки, чтоб языки ваши отсохли!", "words": ["тепёрь"], "current": "тепёрь", "proposed": "теперь", "status": "applied", "number": 69}
{"line": 1165, "phrase": "КӀАЛГИ БАХЬИН ГЬАБУН, МАХЬАГИ ЧӀЕГӀЕР ГЬАБУН", "page": 175, "path": ["senses", 0, "translation"], "text": "Ртом бёлый, сычугом чёрный (о лицемере).", "words": ["бёлый", "чёрный"], "current": "бёлый", "proposed": "белый", "status": "applied", "number": 70}
{"line": 1169, "phrase": "КӀАЛДИБ ЛЪИМ ККУН", "page": 175, "path": ["examples", 0, "ru"], "text": "— И земля у нас прекрасная для садов и вино градников! — с воодушевлёнием пересчитывает Гасан-бёг богатства, которые ждут самостоятельный религиозный Дагестан.", "words": ["воодушевлёнием", "Гасан-бёг"], "current": "воодушевлёнием", "proposed": "воодушевлением", "status": "applied", "number": 71}
{"line": 1172, "phrase": "КӀАЛДИБ НАЦӀ БАЗЕ", "page": 176, "path": ["examples", 0, "ru"], "text": "Ёсли сам окажется на высоком посту, ему наплевать, что народ живёт впроголодь.", "words": ["Ёсли", "живёт"], "current": "Ёсли", "proposed": "Если", "status": "applied", "number": 72}
{"line": 1185, "phrase": "КӀАЛЗУЛ ЖУГЬА", "page": 177, "path": ["examples", 0, "ru"], "text": "Ёсли б хоть слово услышать от тебя, В честь любви воздвиг бы памятник я.", "words": ["Ёсли"], "current": "Ёсли", "proposed": "Если", "status": "applied", "number": 73}
{"line": 1189, "phrase": "КӀАЛ-МАЦӀ ККВЕЗЕ", "page": 178, "path": ["examples", 0, "ru"], "text": "Ёсли вдруг на чужбине умру я, Горсть земли родной я возьму с собой.", "words": ["Ёсли"], "current": "Ёсли", "proposed": "Если", "status": "applied", "number": 74}
{"line": 1247, "phrase": "ЛЪАРАЛЪА КЪВАТӀИВЕГИ ВАХЪУН, ГӀУРУЛЪЕ ЛЪУГЬИНЁ", "page": 186, "path": ["phrase"], "text": "ЛЪАРАЛЪА КЪВАТӀИВЕГИ ВАХЪУН, ГӀУРУЛЪЕ ЛЪУГЬИНЁ", "words": ["ЛЪУГЬИНЁ"], "current": "ЛЪУГЬИНЁ", "proposed": "ЛЪУГЬИНЕ", "status": "applied", "number": 75}
{"line": 1248, "phrase": "ЛЪАРАЛЪЕ РЕХАРАБ ЧӀИМИХ ГӀАДИН", "page": 186, "path": ["senses", 0, "literal"], "text": "как камушек, брошенный в рёчку", "words": ["рёчку"], "current": "рёчку", "proposed": "речку", "status": "applied", "number": 76}
