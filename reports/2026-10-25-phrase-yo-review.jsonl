{"line": 1658, "phrase": "РАКӀ ГӀИНКЪАВ", "page": 245, "path": ["examples", 0, "ru"], "text": "Для бестолковых людёй эти бедняки Были опорой ума.", "words": ["людёй"], "current": "людёй", "proposed": "людей", "status": "applied", "number": 106}
