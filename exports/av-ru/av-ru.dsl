	[m1][b]1. [/b]самец; ослёнок [i]самец[/i][/m1]
	[m2][ex]бихьинаб бацӏ — волк[/ex][/m2]
	[m2][ex]бихьинаб болъон — боров, хряк[/ex][/m2]
	[m2][ex]бихьинаб варани — верблюд[/ex][/m2]
	[m2][ex]бихьинаб гургур — индюк[/ex][/m2]
	[m2][ex]бихьинаб гӏанкӏ — заяц (самец), кролик[/ex][/m2]
	[m2][ex]бихьинаб гӏорцӏен — мул-самец[/ex][/m2]
	[m2][ex]бихьинаб кьегӏер — барашек, баранчик[/ex][/m2]
	[m2][ex]бихьинаб тайи — жеребчик[/ex][/m2]
	[m2][ex]бихьинаб хъаз — селезень, гусак[/ex][/m2]
	[m2][ex]бихьинаб цер — лис[/ex][/m2]
