#NAME	Аварско-русский словарь (sources.avar.me)
#INDEX_LANGUAGE	Avar
#CONTENTS_LANGUAGE	Russian

а
	[m1][i]существительное, именительный[/i][/m1]
	[m1][i]формы:[/i] а, аялъ, аялъул[/m1]
	[m1]а [i]первая буква аварского алфавита[/i][/m1]
	[m2][ex]гьитӏинаб а — малая (строчная) а[/ex][/m2]
	[m2][ex]кӏудияб а — большая (прописная) А[/ex][/m2]
	[m2][ex]а хӏарп — буква а[/ex][/m2]
	[m2][ex]гьедин гьабуни, иш аялда букӏинаан — если сделаешь так, дело пошло бы на лад[/ex][/m2]
	[m2][ex]а абуни, беги абизе ккола — раз сказал "а", скажи \[вслед\] "бе"[/ex][/m2]

а
	[m1][i]глагол, повелительное[/i][/m1]
	[m1]уходи; ступай [i]повел. от ине иди (отсюда)[/i][/m1]
	[m1][i]см. также:[/i] [ref]ине[/ref][/m1]

аб
	[m1][i]местоимение, именительный[/i][/m1]
	[m1][i]формы:[/i] аб, алъ, алъул, ал[/m1]
	[m1]этот, эта, это; только это [i](местоимение, указательное местоимение)[/i][/m1]
	[m2][ex]аб дир къалам буго — это мой карандаш[/ex][/m2]
	[m2][ex]аб лъил чу? — чья эта лошадь?[/ex][/m2]
	[m1][i]см. также:[/i] [ref]гьаб[/ref][/m1]

абаб
	[m1][i]местоимение, именительный[/i][/m1]
	[m1][i]формы:[/i] абаб, абабалъ, абабалъул[/m1]
	[m1]вот этот, вот эта, вот это [i](местоимение, указательное местоимение)[/i] [i]о близко расположенном предмете или животном с отделительным оттенком[/i][/m1]
	[m2][ex]абаб босе — вот этот (эту, это) бери[/ex][/m2]

абад
	[m1][i]существительное, именительный[/i][/m1]
	[m1]вечность[/m1]
	[m2][ex]абад гьечӏеб — невечный, преходящий[/ex][/m2]
	[m2][ex]дуниялалъул рукъ — абад гьечӏеб жо, ахираталъул рукъ — абадияб жо — земное жилище — преходяще, загробное жилище — вечное[/ex][/m2]

абадияб
	[m1][i]прилагательное[/i][/m1]
	[m1][i]формы по классам:[/i] абадияб, абадияв, абадияй[/m1]
	[m1][b]1. [/b]вечный, непреходящий[/m1]
	[m2][ex]абадияб рукъ — загробная жизнь; вечное пристанище; вечный мир; тот свет [i](букв. вечный дом)[/i][/ex][/m2]
	[m1][i]см. также:[/i] [ref]абадул-абадияб[/ref][/m1]

абадияб-даимаб
	[m1][i]прилагательное[/i][/m1]
	[m1][i]формы по классам:[/i] абадияб-даимаб, абадияв-даимав, абадияй-даимай[/m1]
	[m1]вечный[/m1]
	[m1][i]см. также:[/i] [ref]абадияб[/ref], [ref]абадул-абадияб[/ref][/m1]

абадиялъ
	[m1][i]наречие[/i][/m1]
	[m1][i]формы:[/i] абадиялъ, абадиялъго[/m1]
	[m1][b]1. [/b]навсегда, навеки, навечно; на вечные времена [i](наречие)[/i][/m1]
	[m2][ex]абадиялъ анив хутӏулев чи вукӏунаро — нет человека, который остаётся навечно здесь [i](т. е. в этом мире)[/i][/ex][/m2]
	[m1][b]2. [/b]никогда, никогда в жизни [i](в переносном значении)[/i][/m1]
	[m2][ex]абадиялъ ракӏалде ккелароан дос гьеб иш гьабилилан — никогда в жизни не подумал бы, что он поступит так[/ex][/m2]
	[m1][i]см. также:[/i] [ref]абадул-абадиялъ[/ref][/m1]

абадият
	[m1][i]существительное, именительный[/i][/m1]
	[m1][i]формы:[/i] абадият, абадияталъ, абадияталъул[/m1]
	[m1]вечность без конца [i]в противоположность вечности без начала[/i][/m1]

абадул-абадияб
	[m1][i]прилагательное[/i][/m1]
	[m1][i]формы по классам:[/i] абадул-абадияб, абадул-абадияв, абадул-абадияй[/m1]
	[m1]вечный, непреходящий[/m1]
	[m1][i]см. также:[/i] [ref]абадияб[/ref][/m1]

абадул-абадиялъ
	[m1][i]наречие[/i][/m1]
	[m1][i]формы:[/i] абадул-абадиялъ, абадул-абадиялъго[/m1]
	[m1]вечно, навсегда, навеки; во веки веков [i](наречие)[/i][/m1]
	[m2][ex]абадул-абадиялъ алжаналъув хутӏана — навсегда остался в раю[/ex][/m2]
	[m1][i]см. также:[/i] [ref]абадиялъ[/ref][/m1]

